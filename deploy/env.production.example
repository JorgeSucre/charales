# Variables de la API en producción. Plantilla sin valores reales: la copia va en /etc/charales/api.env, nunca en Git.
# La API se niega a arrancar si falta o es peligroso algo de lo marcado como obligatorio (api/config.ts).
NODE_ENV=production                    # obligatorio
PORT=3000

# Base de datos: la cuenta de EJECUCIÓN, sin privilegios de esquema (deploy/mariadb/cuentas.sql).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=escuela_futbol
DB_USER=charales_app
DB_PASSWORD=
DB_POOL_SIZE=10

# Obligatorio: las IP o rangos CIDR del proxy inverso. «none» sólo si ningún proxy atiende a la API.
TRUSTED_PROXIES=127.0.0.1

# Obligatorio y https: dirección pública de la app, para los enlaces de los correos.
APP_URL=https://escuela.example

# Obligatorio: resend o none. Con none, invitaciones y recuperación responden 503.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=Charales <no-responder@escuela.example>

# Días que se conserva la dirección de un correo ya cerrado (1-365). No es un plazo legal: fíjalo según tu política.
CORREO_RETENCION_DIAS=30

# Dimensionar con la memoria real del servidor (unos 19 MiB por operación, por proceso).
ARGON2_MAX_CONCURRENT=3
ARGON2_WAIT_MS=2000
