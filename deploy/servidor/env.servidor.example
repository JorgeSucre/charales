# Variables de la API en el servidor del curso: frontend en Apache (http://45.80.152.66) y API con PM2 en :3002, sin
# HTTPS ni proxy. Plantilla SIN secretos: la copia real es backend/.env (modo 600), nunca en Git (DEPLOYMENT.md).
# Sólo nombres que lee la API (api/config.ts, api/server.ts, api/mail.ts). Sin comentarios en la misma línea.
NODE_ENV=production

# API: todas las interfaces, puerto 3002.
HOST=0.0.0.0
PORT=3002

# Dirección donde Apache sirve la app. Es también el único origen que CORS acepta: debe coincidir EXACTAMENTE con lo
# que muestra el navegador (esquema, IP y puerto; sin puerto = 80).
APP_URL=http://45.80.152.66

# Sin HTTPS: la cookie de sesión no lleva Secure. La API lo acepta en producción sólo junto con APP_URL http://.
COOKIE_SECURE=false

# No hay proxy delante de la API: cuenta la IP de la conexión.
TRUSTED_PROXIES=none

# Sin proveedor de correo: invitaciones y recuperación de contraseña responden 503 (no hay variable MAIL_URL).
MAIL_PROVIDER=none

# MariaDB. DB_HOST y DB_PORT: PENDIENTES, los da el profesor (no se suponen). Si MariaDB está en el mismo servidor,
# compruébalo con:  ss -ltnp | grep -Ei 'mariadb|mysql'
DB_HOST=
DB_PORT=
DB_NAME=charalesdb
DB_USER=charalesdb
DB_PASSWORD=
DB_POOL_SIZE=10
