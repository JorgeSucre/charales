# Configuración local de la API. Copia este archivo a `.env` (que NO se versiona) y ajusta los valores.
# Guía completa: docs/SETUP.md. Todas las variables también pueden venir del entorno (útil en un servidor).

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3000
# URL donde se abre la app; con ella se arman los enlaces de los correos (recuperación, invitaciones).
APP_URL=http://localhost:4200

# ── MariaDB ───────────────────────────────────────────────────────────────────
DB_NAME=escuela_futbol
# Conexión por TCP (lo habitual en Windows y con una cuenta con contraseña)…
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=charales
DB_PASSWORD=cambia-esta-contrasena
# …o por socket local con autenticación unix_socket (Linux/macOS, sin contraseña). Si se define, ignora DB_HOST/DB_PORT.
# DB_SOCKET=/tmp/mysql.sock
DB_POOL_SIZE=5

# ── Sesión ────────────────────────────────────────────────────────────────────
# Cookie con atributo Secure: obligatorio con HTTPS. Con NODE_ENV=production siempre se activa.
COOKIE_SECURE=false
# NODE_ENV=production   # sólo en un servidor: activa Secure y desactiva el correo de consola

# ── Correo ────────────────────────────────────────────────────────────────────
# Desarrollo: imprime en la consola de la API los correos (recuperación de contraseña, invitaciones de cuentas) con
# su enlace, para poder probarlos sin un proveedor. Se ignora con NODE_ENV=production. Sin transporte de correo, esas
# operaciones responden 503 y no crean nada (no hay proveedor real todavía: docs/API.md, «Producción»).
MAIL_CONSOLE=true

# ── Primer administrador (opcional) ───────────────────────────────────────────
# `npm run db:admin` los pide en la terminal. Sólo para usarlo sin preguntas; no dejes una contraseña real aquí.
# CHARALES_ADMIN_EMAIL=direccion@tu-escuela.example
# CHARALES_ADMIN_NAME=Nombre Apellido
# CHARALES_ADMIN_PASSWORD=
