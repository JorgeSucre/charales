# Configuración local de la API. Copia este archivo a `.env` (que NO se versiona) y ajusta los valores.
# Guía completa: docs/SETUP.md. Todas las variables también pueden venir del entorno (útil en un servidor).

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3000
# URL donde se abre la app; con ella se arman los enlaces de los correos (recuperación, invitaciones).
APP_URL=http://localhost:4200

# ── MariaDB ───────────────────────────────────────────────────────────────────
DB_NAME=escuela_futbol
# Conexión por TCP (lo habitual en Windows y con una cuenta con contraseña)…
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=charales
DB_PASSWORD=cambia-esta-contrasena
# …o por socket local con autenticación unix_socket (Linux/macOS, sin contraseña). Si se define, ignora DB_HOST/DB_PORT.
# DB_SOCKET=/tmp/mysql.sock
DB_POOL_SIZE=5

# ── Sesión ────────────────────────────────────────────────────────────────────
# Cookie con atributo Secure: obligatorio con HTTPS. Con NODE_ENV=production siempre se activa.
COOKIE_SECURE=false
# IP o rangos CIDR del proxy inverso, separados por comas (sin nombres). Sólo de ellos se cree X-Forwarded-For para saber
# la IP del cliente (límites de intentos, sesiones, auditoría). Vacío o «none» = no hay proxy: cuenta la conexión.
# Con NODE_ENV=production es obligatorio: la API no arranca sin él (usa «none» si de verdad no hay proxy).
TRUSTED_PROXIES=

# ── Argon2id (S-02) ───────────────────────────────────────────────────────────
# Operaciones de Argon2id simultáneas en ESTE proceso de la API (~19 MiB cada una); con varios procesos, el total es
# procesos × este valor. Por defecto 3. Súbelo sólo con la memoria del servidor en mano (docs/API.md, «Argon2id»).
# Un valor inválido impide arrancar.
# ARGON2_MAX_CONCURRENT=3
# Milisegundos que una solicitud espera un turno libre antes de responder 503 (como mucho 32 esperan). Por defecto 2000.
# ARGON2_WAIT_MS=2000
# NODE_ENV=production   # sólo en un servidor: activa Secure y desactiva el correo de consola y las rutas de práctica;
#                       # además exige la configuración de deploy/env.production.example

# ── Correo ────────────────────────────────────────────────────────────────────
# Días que se conserva la dirección de un correo ya cerrado. Por defecto 30; no es un plazo legal (docs/API.md).
# CORREO_RETENCION_DIAS=30
# Límite global de envíos por hora para toda la API (migración 009; docs/API.md). Por defecto 60 y, de ellos, 20 como
# máximo para recuperaciones de contraseña. Ajústalo al plan del proveedor.
# CORREO_MAX_POR_HORA=60
# CORREO_MAX_RECUPERACION_POR_HORA=20
# Desarrollo: imprime en la consola de la API los correos (recuperación de contraseña, invitaciones de cuentas) con
# su enlace, para poder probarlos sin un proveedor. Se ignora con NODE_ENV=production. Sin transporte de correo, esas
# operaciones responden 503 y no crean nada.
MAIL_CONSOLE=true
# Producción: MAIL_PROVIDER=resend con RESEND_API_KEY y MAIL_FROM, o MAIL_PROVIDER=none (docs/deployment).
# MAIL_PROVIDER=
# RESEND_API_KEY=
# MAIL_FROM=

# ── Primer administrador (opcional) ───────────────────────────────────────────
# `npm run db:admin` los pide en la terminal. Sólo para usarlo sin preguntas; no dejes una contraseña real aquí.
# CHARALES_ADMIN_EMAIL=direccion@tu-escuela.example
# CHARALES_ADMIN_NAME=Nombre Apellido
# CHARALES_ADMIN_PASSWORD=
