# Copia a .env (no versionado) y ajusta. La API funciona sin este archivo si las variables vienen del entorno.
PORT=3000
DB_NAME=escuela_futbol
# Conexión por TCP…
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=charales
DB_PASSWORD=
# …o por socket local (autenticación unix_socket, sin contraseña); si se define, ignora DB_HOST/DB_PORT.
# DB_SOCKET=/tmp/mysql.sock
# Cookie con atributo Secure (siempre en NODE_ENV=production). En http://localhost déjalo en false.
COOKIE_SECURE=false
# Sólo desarrollo (HU-005): imprime en la consola de la API el correo de recuperación con su enlace. Sin transporte
# de correo, la recuperación responde 503. Se ignora con NODE_ENV=production (no hay proveedor real todavía).
MAIL_CONSOLE=false
