{
  "name": "project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --host 0.0.0.0 --port 3000",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:start": "npm run api:build \u0026\u0026 node --env-file-if-exists\u003d.env api/server.ts",
    "api:test": "npm run api:build \u0026\u0026 node --env-file-if-exists\u003d.env --test api/*.test.ts",
    "api:typecheck": "tsc -p api \u0026\u0026 tsc -p api/domain \u0026\u0026 tsc -p e2e",
    "db:migrate": "sh db/scripts/migrate.sh",
    "db:reset": "sh db/scripts/reset.sh",
    "db:test": "sh db/scripts/test.sh",
    "db:mariadb:test-backup": "sh db/mariadb/scripts/test-backup-restore.sh",
    "db:mariadb:dev-seed": "npm run db:setup -- --dev-seed",
    "api:build": "esbuild api/domain/index.ts --bundle --platform\u003dnode --format\u003desm --packages\u003dexternal --tsconfig\u003dtsconfig.json --outfile\u003dapi/.build/domain.mjs --log-level\u003dwarning",
    "db:mariadb:migrate": "sh db/mariadb/scripts/migrate.sh",
    "db:mariadb:demo": "npm run api:build \u0026\u0026 node --env-file-if-exists\u003d.env api/demo.ts",
    "e2e": "npm run build \u0026\u0026 npm run api:build \u0026\u0026 node --env-file-if-exists\u003d.env --test e2e/*.e2e.ts",
    "db:setup": "npm run api:build \u0026\u0026 node --env-file-if-exists\u003d.env api/setup.ts",
    "db:admin": "npm run api:build \u0026\u0026 node --env-file-if-exists\u003d.env api/create-admin.ts",
    "db:mail-purge": "node --env-file-if-exists\u003d.env api/mail-purge.ts",
    "db:access-link": "node --env-file-if-exists\u003d.env api/access-link.ts",
    "db:datos-personales": "node --env-file-if-exists\u003d.env api/datos-personales.ts",
    "test:all": "ng test --watch\u003dfalse \u0026\u0026 npm run api:typecheck \u0026\u0026 npm run api:test",
    "build:servidor": "ng build --configuration production,servidor"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "mariadb": "^3.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
