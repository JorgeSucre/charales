{
  "name": "project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:start": "npm run api:build && node --env-file-if-exists=.env api/server.ts",
    "api:test": "npm run api:build && node --env-file-if-exists=.env --test api/*.test.ts",
    "api:typecheck": "tsc -p api && tsc -p api/domain && tsc -p e2e",
    "db:migrate": "sh db/scripts/migrate.sh",
    "db:reset": "sh db/scripts/reset.sh",
    "db:test": "sh db/scripts/test.sh",
    "db:mariadb:test-backup": "sh db/mariadb/scripts/test-backup-restore.sh",
    "db:mariadb:dev-seed": "npm run db:setup -- --dev-seed",
    "api:build": "esbuild api/domain/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=api/.build/domain.mjs --log-level=warning",
    "db:mariadb:migrate": "sh db/mariadb/scripts/migrate.sh",
    "db:mariadb:demo": "npm run api:build && node --env-file-if-exists=.env api/demo.ts",
    "e2e": "npm run build && npm run api:build && node --env-file-if-exists=.env --test e2e/*.e2e.ts",
    "db:setup": "npm run api:build && node --env-file-if-exists=.env api/setup.ts",
    "db:admin": "npm run api:build && node --env-file-if-exists=.env api/create-admin.ts",
    "test:all": "ng test --watch=false && npm run api:typecheck && npm run api:test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "mariadb": "^3.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
